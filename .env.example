# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used in server-side scripts (e.g. seeding). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for building links in emails (password reset, invites)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
